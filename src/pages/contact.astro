---
import Base from '../layouts/Base.astro';
import BranchMap from '../components/BranchMap.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { school } from '../lib/data';
---
<Base title="Contact" current="contact" description="Addresses, phone numbers, WhatsApp and a map for both Rainbow Kidz Pre School branches in Gurugram.">
  <section class="wrap pt-8 pb-16">
    <h1>Contact us</h1>
    <p class="mt-5 measure text-xl text-ink-soft">Call or WhatsApp either branch, or pick one to see it on the map. For anything else, email
      <a class="font-semibold underline underline-offset-4" href={`mailto:${school.school.email}`}>{school.school.email}</a>.</p>
    <div class="mt-12"><BranchMap /></div>
  </section>
  <section class="wrap pb-24">
    <h2 class="!text-3xl">Find us online</h2>
    <div class="mt-6"><SocialLinks /></div>
  </section>
</Base>
