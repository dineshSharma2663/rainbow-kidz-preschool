---
import { school } from '../lib/data';
import { icons } from '../lib/icons';

/** variant="tiles": large tappable cards (social section). variant="icons": compact row (footer). */
interface Props { variant?: 'tiles' | 'icons'; limit?: number }
const { variant = 'tiles', limit = 4 } = Astro.props;
// Only channels with a real link are shown; add a Facebook or YouTube URL in the JSON to show those.
const links = school.social.filter((s) => s.url).slice(0, limit);
const ext = (u: string) => (u.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---
{variant === 'tiles' ? (
  <ul class="tiles" role="list">
    {links.map((s) => (
      <li>
        <a href={s.url} {...ext(s.url!)} class="tile" style={`--brand:${s.color}`}>
          <span class="badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="30" height="30"><path d={icons[s.id]} fill="currentColor" /></svg>
          </span>
          <span class="font-display font-bold text-xl leading-tight">{s.label}</span>
          <span class="text-ink-soft text-[0.95rem] break-all">{s.handle}</span>
        </a>
      </li>
    ))}
  </ul>
) : (
  <ul class="flex gap-3" role="list">
    {links.map((s) => (
      <li>
        <a href={s.url} {...ext(s.url!)} aria-label={s.label} title={s.label} class="mini" style={`--brand:${s.color}`}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={icons[s.id]} fill="currentColor" /></svg>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .tiles { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .tile {
    display: grid; gap: .35rem; align-content: start; height: 100%;
    padding: 1.4rem; border-radius: 24px; background: #fff;
    box-shadow: inset 0 0 0 2px rgb(30 42 90 / .1);
    transition: box-shadow .15s ease, transform .15s ease;
  }
  .tile:hover { box-shadow: inset 0 0 0 3px var(--brand); transform: translateY(-2px); }
  .badge { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; margin-bottom: .6rem; border-radius: 16px; color: #fff; background: var(--brand); }
  .mini { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 14px; background: #fff; color: var(--brand); transition: transform .15s ease; }
  .mini:hover { transform: translateY(-2px) rotate(-4deg); }
</style>
