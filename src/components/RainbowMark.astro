---
/** Seven concentric arcs. Used in the hero (optionally with the school name curved over the top) and on the 404 page.
 *  Geometry: viewBox width 100, arcs centred at (50, 50), outer radius 46. The baseline stays at y=50 whether
 *  or not a label is shown; a label only adds headroom above, so layouts below the arc don't move. */
interface Props { size?: number; stroke?: number; class?: string; animate?: boolean; label?: string }
const { size = 40, stroke = 3, class: cls = '', animate = false, label } = Astro.props;
const colors = ['#ef4444', '#f97316', '#facc15', '#22c55e', '#3b82f6', '#6366f1', '#a855f7'];
const r0 = 46;
const gap = stroke * 1.15;
const top = label ? -9 : 0;
const textR = r0 + stroke / 2 + 2.6; // just outside the red band
const uid = `arc-${Math.random().toString(36).slice(2, 8)}`;
---
<svg viewBox={`0 ${top} 100 ${52 - top}`} width={size} height={size * (52 - top) / 100}
     class:list={[cls, { 'arc-draw': animate }]} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  {colors.map((c, i) => {
    const r = r0 - i * gap;
    return (
      <path d={`M ${50 - r} 50 A ${r} ${r} 0 0 1 ${50 + r} 50`} fill="none" stroke={c} stroke-width={stroke}
            stroke-linecap="round" pathLength="1" style={`--i:${i}`} />
    );
  })}
  {label && (
    <>
      <path id={uid} d={`M ${50 - textR} 50 A ${textR} ${textR} 0 0 1 ${50 + textR} 50`} fill="none" />
      <text class="arc-label"><textPath href={`#${uid}`} startOffset="50%" text-anchor="middle">{label}</textPath></text>
    </>
  )}
</svg>

<style>
  /* Draw-on-view: the arcs wait undrawn until an ancestor gets .play (added when the
     rainbow scrolls into view, removed when it fully leaves, so it redraws on return).
     Only when motion is allowed (html.motion); otherwise the rainbow is simply shown. */
  .arc-label { font-family: var(--font-display); font-weight: 800; font-size: 6.4px; letter-spacing: .06em; fill: var(--color-ink); }
  :global(.motion) .arc-draw path[style] { stroke-dasharray: 1; stroke-dashoffset: 1; }
  :global(.motion) .arc-draw .arc-label { opacity: 0; }
  :global(.motion .play) .arc-draw path[style] {
    animation: draw 1.1s cubic-bezier(.6, .1, .2, 1) forwards;
    animation-delay: calc(var(--i) * 110ms);
  }
  :global(.motion .play) .arc-draw .arc-label { animation: label-in .6s ease forwards 1s; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes label-in { from { opacity: 0; } to { opacity: 1; } }
</style>
