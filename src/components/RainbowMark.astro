---
/** Seven concentric arcs. Used small as the logo stand-in and large in the hero.
 *  Replace with the school's official logo once the file is available. */
interface Props { size?: number; stroke?: number; class?: string; animate?: boolean }
const { size = 40, stroke = 3, class: cls = '', animate = false } = Astro.props;
const colors = ['#ef4444', '#f97316', '#facc15', '#22c55e', '#3b82f6', '#6366f1', '#a855f7'];
const r0 = 46;
const gap = stroke * 1.15;
---
<svg viewBox="0 0 100 52" width={size} height={size * 0.52} class:list={[cls, { 'arc-draw': animate }]} aria-hidden="true">
  {colors.map((c, i) => {
    const r = r0 - i * gap;
    return (
      <path
        d={`M ${50 - r} 50 A ${r} ${r} 0 0 1 ${50 + r} 50`}
        fill="none" stroke={c} stroke-width={stroke} stroke-linecap="round"
        pathLength="1" style={`--i:${i}`}
      />
    );
  })}
</svg>

<style>
  .arc-draw path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.1s cubic-bezier(.6, .1, .2, 1) forwards;
    animation-delay: calc(var(--i) * 110ms);
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .arc-draw path { stroke-dashoffset: 0; animation: none; }
  }
</style>
