---
import '../styles/global.css';
import { Image } from 'astro:assets';
import SocialLinks from '../components/SocialLinks.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import { school, url, img, primaryBranch, telHref, waHref, toneOrder, hex, tone } from '../lib/data';

const logo = img(school.school.logo);

interface Props { title?: string; description?: string; current?: 'home' | 'events' | 'admissions' | 'contact' }
const { title, description, current = 'home' } = Astro.props;

const name = school.school.name;
const pageTitle = title ? `${title} | ${name}` : `${name}, Gurugram`;
const metaDescription = description ??
  `${name} in Gurugram: Playgroup, Nursery, LKG and UKG at Dharam Colony (Palam Vihar Extn.) and Rajendra Park. Admissions open for ${school.admissions.currentSession}.`;

// Demo build: keep search engines out until the school approves the content.
const isDemo = school._meta.status === 'demo-draft';

const nav = [
  { id: 'events', label: 'Events', href: url('events/') },
  { id: 'admissions', label: 'Admissions', href: url('admissions/') },
  { id: 'contact', label: 'Contact', href: url('contact/') },
];
const phone = primaryBranch.phones[0];
const waText = `Hello, I'd like to know about admissions at ${name}.`;
---
<!doctype html>
<html lang="en" data-theme="indigo">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {isDemo && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#eef0ff" />
    <!-- Apply the visitor's saved colour before first paint (no flash). Default: indigo. -->
    <script is:inline>
      try { var t = localStorage.getItem('rk-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="apple-touch-icon" href={url('favicon.png')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-dvh flex flex-col pb-[4.5rem] md:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 btn">Skip to content</a>

    <header class="site-header relative z-30">
      <div class="wrap hdr">
        <a href={url()} class="brand rounded-lg" aria-label={`${name} home`}>
          <Image src={logo} alt="" width={64} height={64} densities={[1, 2]} loading="eager" class="brand-logo rounded-full" />
          <span class="wordmark font-display font-extrabold leading-none">
            Rainbow Kidz<span class="wordmark-sub block font-semibold text-ink-soft tracking-normal">Pre School, Gurugram</span>
          </span>
        </a>
        <nav aria-label="Main" class="hdr-nav">
          {nav.map((n) => (
            <a href={n.href} aria-current={current === n.id ? 'page' : undefined}
               class="px-3.5 py-2 rounded-full font-display font-semibold text-lg hover:bg-chalk aria-[current=page]:bg-chalk">{n.label}</a>
          ))}
        </nav>
        <a href={telHref(phone)} class="btn hdr-call" style={tone('theme')}>Call {phone.replace('+91 ', '')}</a>
        <ThemeSwitcher />
        <button type="button" class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
          <span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="sr-only">Menu</span>
        </button>
      </div>
      <nav id="mobile-menu" class="menu-panel" aria-label="Main" data-menu hidden>
        <div class="wrap py-3 grid gap-1">
          <a href={url()} class="menu-link" aria-current={current === 'home' ? 'page' : undefined}>Home</a>
          {nav.map((n) => <a href={n.href} class="menu-link" aria-current={current === n.id ? 'page' : undefined}>{n.label}</a>)}
          <a href={telHref(phone)} class="btn mt-2 justify-self-start" style={tone('theme')}>Call {phone}</a>
        </div>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-auto bg-ink text-white transition-colors duration-400">
      <div class="flex h-2" aria-hidden="true">
        {toneOrder.map((t) => <span class="flex-1" style={`background:${hex(t)}`}></span>)}
      </div>
      <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <Image src={logo} alt="Rainbow Kidz Pre School logo" width={84} height={84} densities={[1, 2]} class="w-[84px] h-[84px] rounded-full mb-4 ring-4 ring-white/15" />
          <p class="font-display font-extrabold text-3xl">Rainbow Kidz Pre School</p>
          <p class="mt-2 text-white/75 measure">{school.school.taglines[0]}</p>
          <div class="mt-6"><SocialLinks variant="icons" /></div>
        </div>
        {school.branches.map((b) => (
          <div>
            <p class="font-display font-bold text-xl">{b.name}</p>
            <ul class="mt-2 space-y-1 text-white/75">
              {b.phones.map((p) => <li><a class="hover:text-white" href={telHref(p)}>{p}</a></li>)}
            </ul>
            {b.address && <p class="mt-3 text-white/60 text-base leading-snug">{b.address}</p>}
          </div>
        ))}
      </div>
      <p class="wrap pb-8 text-sm text-white/55">
        © {new Date().getFullYear()} Rainbow Kidz Pre School. Photos from the school's Instagram.
      </p>
    </footer>

    <!-- Phone action bar: parents mostly arrive from Instagram on mobile -->
    <nav aria-label="Quick contact" class="md:hidden fixed inset-x-0 bottom-0 z-30 bg-white/95 backdrop-blur border-t-2 border-chalk">
      <div class="grid grid-cols-3 gap-2 px-3 py-2.5">
        <a href={telHref(phone)} class="btn !text-base !px-2" style="--tone:var(--color-ink);--tone-ink:#000;--tone-on:#fff">Call</a>
        <a href={waHref(phone, waText)} class="btn !text-base !px-2" style="--tone:#16a34a;--tone-ink:#166534" rel="noopener">WhatsApp</a>
        <a href={url('admissions/#enquire')} class="btn !text-base !px-2" style={tone('theme')}>Enquire</a>
      </div>
    </nav>
    <style>
      /* ---------- Adaptive header ----------
         Items drop in a fixed order as space shrinks, so nothing overlaps or clips:
         Call button (<1200) -> links into Menu (<900) -> subtitle (<560) -> name (<=420). */
      .hdr { display: flex; align-items: center; gap: .75rem; padding-block: .9rem; }
      .brand { display: flex; align-items: center; gap: .75rem; margin-right: auto; min-width: 0; }
      .brand-logo { width: 64px; height: 64px; flex: none; }
      .wordmark { white-space: nowrap; font-size: 1.65rem; }
      .wordmark-sub { font-size: 1rem; margin-top: .3rem; }
      .hdr-nav { display: flex; align-items: center; gap: .15rem; }
      .hdr-call { flex: none; }
      .menu-btn { display: none; flex: none; width: 2.9rem; height: 2.9rem; border-radius: 14px; place-items: center; background: var(--chalk); box-shadow: inset 0 0 0 1.5px oklch(.88 .03 var(--h)); }
      .menu-icon { display: grid; gap: 4px; width: 20px; }
      .menu-icon i { display: block; height: 2.5px; border-radius: 2px; background: var(--color-ink); transition: transform .3s ease, opacity .2s ease; }
      .menu-btn[aria-expanded='true'] .menu-icon i:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
      .menu-btn[aria-expanded='true'] .menu-icon i:nth-child(2) { opacity: 0; }
      .menu-btn[aria-expanded='true'] .menu-icon i:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
      .menu-panel { position: absolute; inset-inline: 0; top: 100%; background: #fff; border-block: 1.5px solid oklch(.92 .02 var(--h)); box-shadow: 0 18px 30px -20px rgb(0 0 0 / .35); }
      .menu-panel:not([hidden]) { animation: menu-in .3s cubic-bezier(.2, .8, .2, 1); }
      @keyframes menu-in { from { opacity: 0; translate: 0 -10px; } }
      .menu-link { padding: .8rem 1rem; border-radius: 14px; font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; }
      .menu-link:hover, .menu-link[aria-current='page'] { background: var(--chalk); }

      @media (max-width: 1199px) { .hdr-call { display: none; } .brand-logo { width: 60px; height: 60px; } }
      @media (max-width: 899px)  { .hdr-nav { display: none; } .menu-btn { display: grid; } .brand-logo { width: 56px; height: 56px; } .wordmark { font-size: 1.5rem; } }
      @media (min-width: 900px)  { .menu-panel { display: none; } }
      @media (max-width: 559px)  { .wordmark-sub { display: none; } .brand-logo { width: 50px; height: 50px; } .wordmark { font-size: 1.35rem; } .hdr { gap: .5rem; } }
      @media (max-width: 420px)  { .wordmark { display: none; } .brand-logo { width: 48px; height: 48px; } }
    </style>
    <script>
      // Fade-and-slide reveals + fading parallax. Skipped entirely for reduced-motion users.
      // Mobile menu
      const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
      const menu = document.querySelector<HTMLElement>('[data-menu]')!;
      const setMenu = (open: boolean) => { menu.hidden = !open; menuBtn.setAttribute('aria-expanded', String(open)); };
      menuBtn.addEventListener('click', () => setMenu(menu.hidden));
      menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setMenu(false); menuBtn.focus(); } });
      document.addEventListener('click', (e) => { if (!menu.hidden && !(e.target as HTMLElement).closest('.site-header')) setMenu(false); });

      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!calm) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

        // data-parallax="speed": positive drifts down slower than the page, negative moves against it.
        // data-parallax-mode="hero": driven by page scroll from the top and fades out as it leaves.
        const items = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
        let queued = false;
        const update = () => {
          const vh = innerHeight;
          for (const el of items) {
            const speed = Number(el.dataset.parallax);
            if (el.dataset.parallaxMode === 'hero') {
              // Each element fades by ITS OWN position: fully visible until its top reaches the
              // top of the screen, then drifts and fades as it leaves. (Fading by page scroll
              // made the stacked mobile rainbow vanish while it was still on screen.)
              const shift = Number(el.dataset.py || 0);
              const r = el.getBoundingClientRect();
              const top = r.top - shift;             // layout position without our own translate
              const past = Math.max(0, -top);        // px of the element scrolled above the screen
              const py = past * speed;
              el.dataset.py = String(py);
              el.style.setProperty('--py', `${py.toFixed(1)}px`);
              el.style.setProperty('--po', Math.max(0, 1 - past / (r.height * 0.85)).toFixed(3));
            } else {
              const r = el.getBoundingClientRect();
              if (r.bottom < -200 || r.top > vh + 200) continue;
              el.style.setProperty('--py', `${((r.top + r.height / 2 - vh / 2) * speed).toFixed(1)}px`);
            }
          }
          queued = false;
        };
        addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
        addEventListener('resize', update);
        update();
      }
    </script>
  </body>
</html>
